        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    actor Validator as ROE Validator\n    participant UI as Review Dashboard\n    participant Auth as Authentication Service\n    participant API as Backend API\n    participant ROE as ROE Validation Service\n    participant DB as Database\n    participant Token as Scope Token Service\n\n    Validator-&gt;&gt;UI: Login\n    UI-&gt;&gt;Auth: Submit credentials\n    Auth-&gt;&gt;DB: Verify credentials and reviewer role\n    DB--&gt;&gt;Auth: Account and role status\n    Auth--&gt;&gt;UI: Create authenticated session\n    UI--&gt;&gt;Validator: Show review dashboard\n\n    Validator-&gt;&gt;UI: Open review queue\n    UI-&gt;&gt;API: Request flagged ROE documents\n    API-&gt;&gt;Auth: Check reviewer permission\n    Auth--&gt;&gt;API: Access allowed\n    API-&gt;&gt;DB: Retrieve flagged documents\n    DB--&gt;&gt;UI: Display review queue\n\n    Validator-&gt;&gt;UI: Open ROE document\n    UI-&gt;&gt;API: Request document and validation details\n    API-&gt;&gt;DB: Retrieve ROE details\n    DB--&gt;&gt;UI: Show document and validation flags\n\n    Validator-&gt;&gt;UI: Submit review decision\n    UI-&gt;&gt;API: Approve, reject or request correction\n    API-&gt;&gt;ROE: Validate and record manual decision\n    ROE-&gt;&gt;DB: Save decision, reviewer and timestamp\n\n    alt Approved\n        ROE-&gt;&gt;Token: Request scope token\n        Token-&gt;&gt;DB: Save token and approved scope\n        Token--&gt;&gt;ROE: Token issued\n        ROE--&gt;&gt;UI: ROE approved\n    else Rejected\n        ROE--&gt;&gt;UI: ROE rejected; no token issued\n    else Correction requested\n        ROE--&gt;&gt;UI: Request corrected document; no token issued\n    end\n\n    UI--&gt;&gt;Validator: Show final review status\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="VOFLOoWeAH6GnKUwlx9Y-1">
