        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    actor Admin\n    participant UI as Admin Dashboard\n    participant Auth as Authentication Service\n    participant API as Backend API\n    participant ROE as ROE Validator\n    participant DB as Database\n    participant System as PenflowAI Engine\n\n    Admin-&gt;&gt;UI: Login\n    UI-&gt;&gt;Auth: Submit credentials\n    Auth-&gt;&gt;DB: Verify credentials and role\n    DB--&gt;&gt;Auth: Account and role status\n    Auth--&gt;&gt;UI: Create authenticated session\n    UI--&gt;&gt;Admin: Show admin dashboard\n\n    Admin-&gt;&gt;UI: Review ROE or open review queue\n    UI-&gt;&gt;API: Request ROE records\n    API-&gt;&gt;Auth: Check admin permission\n    Auth--&gt;&gt;API: Access allowed\n    API-&gt;&gt;DB: Retrieve ROE records\n    DB--&gt;&gt;UI: Display review queue\n\n    opt Admin reviews a flagged ROE\n        Admin-&gt;&gt;UI: Approve, reject or request correction\n        UI-&gt;&gt;API: Submit review decision\n        API-&gt;&gt;ROE: Record decision\n        ROE-&gt;&gt;DB: Save decision and timestamp\n        ROE--&gt;&gt;UI: Updated ROE status\n    end\n\n    Admin-&gt;&gt;UI: Manage user accounts\n    UI-&gt;&gt;API: Submit account change\n    API-&gt;&gt;Auth: Check admin permission\n    API-&gt;&gt;DB: Update user account\n    DB--&gt;&gt;UI: Updated account status\n\n    Admin-&gt;&gt;UI: Manage tools or model configuration\n    UI-&gt;&gt;API: Submit configuration request\n    API-&gt;&gt;Auth: Check admin permission\n    API-&gt;&gt;System: Apply supported configuration\n    System--&gt;&gt;UI: Operation result\n\n    Admin-&gt;&gt;UI: View audit logs\n    UI-&gt;&gt;API: Request system audit logs\n    API-&gt;&gt;Auth: Check admin permission\n    API-&gt;&gt;DB: Retrieve system-wide logs\n    DB--&gt;&gt;UI: Return audit records\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="VOFLOoWeAH6GnKUwlx9Y-94">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;labelBackgroundColor=none;fontColor=#393C56;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
