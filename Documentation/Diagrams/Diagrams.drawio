        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nsequenceDiagram\n    actor Tester\n    participant UI as PenflowAI Website\n    participant Auth as Authentication Service\n    participant API as Backend API\n    participant ROE as ROE Validator\n    participant Engine as Testing Engine\n    participant DB as Database\n\n    Tester-&gt;&gt;UI: Register or Login\n    UI-&gt;&gt;Auth: Submit credentials\n    Auth-&gt;&gt;DB: Verify account and credentials\n    DB--&gt;&gt;Auth: Account status\n    Auth--&gt;&gt;UI: Session or verification request\n    UI--&gt;&gt;Tester: Show dashboard after authentication\n\n    Tester-&gt;&gt;UI: Verify email\n    UI-&gt;&gt;Auth: Confirm email\n    Auth--&gt;&gt;UI: Email verified\n\n    Tester-&gt;&gt;UI: Add target and prove ownership\n    UI-&gt;&gt;API: Submit target and ownership proof\n    API-&gt;&gt;DB: Save verified target\n    DB--&gt;&gt;UI: Target status\n\n    Tester-&gt;&gt;UI: Upload ROE and confirm authorization\n    UI-&gt;&gt;API: Submit ROE\n    API-&gt;&gt;ROE: Validate ROE\n    ROE--&gt;&gt;API: Validation status\n    API--&gt;&gt;UI: Show ROE status\n\n    alt ROE approved\n        Tester-&gt;&gt;UI: Start security test\n        UI-&gt;&gt;API: Request test\n        API-&gt;&gt;Engine: Check scope token and targets\n        Engine-&gt;&gt;Engine: Recon, scan and controlled testing\n        Engine-&gt;&gt;DB: Save findings and action logs\n        Engine-&gt;&gt;Engine: Score and organize findings\n        Engine-&gt;&gt;Engine: Generate report\n        Engine-&gt;&gt;DB: Save report\n        API--&gt;&gt;UI: Test progress and results\n        Tester-&gt;&gt;UI: Monitor or stop test\n        Tester-&gt;&gt;UI: View findings and download report\n        UI-&gt;&gt;API: Request findings or report\n        API--&gt;&gt;UI: Return authorized results\n    else Rejected or review required\n        API--&gt;&gt;UI: Show reason or review status\n        UI--&gt;&gt;Tester: Wait or upload corrected ROE\n    end\n\n    Tester-&gt;&gt;UI: View own audit logs or settings\n    UI-&gt;&gt;API: Request account data\n    API-&gt;&gt;DB: Retrieve permitted records\n    DB--&gt;&gt;UI: Return records\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="VOFLOoWeAH6GnKUwlx9Y-42">
