  <diagram id="w_jgom_IcoS_HD766Gu-" name="class">
    <mxGraphModel dx="5660" dy="3140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n    direction TB\n\n    class User {\n        +String userId\n        +String name\n        +String email\n        +String passwordHash\n        +String role\n        +String accountStatus\n    }\n\n    class AuthenticationService {\n        +register()\n        +login(email, password)\n        +logout()\n        +verifyCredentials()\n        +verifyEmail()\n        +createSession()\n        +authorizeAccess()\n    }\n\n    class Tester {\n        +registerTarget()\n        +uploadROE()\n        +startSecurityTest()\n        +viewFindings()\n        +viewReport()\n        +viewOwnAuditLogs()\n    }\n\n    class Admin {\n        +login()\n        +reviewROE()\n        +manageUsers()\n        +viewAuditLogs()\n        +monitorSystem()\n    }\n\n    class Target {\n        +String targetId\n        +String targetAddress\n        +String ownershipStatus\n        +verifyOwnership()\n    }\n\n    class ROEDocument {\n        +String roeId\n        +String documentPath\n        +String status\n        +Date startDate\n        +Date endDate\n        +validate()\n    }\n\n    class ROEReview {\n        +String reviewId\n        +String decision\n        +DateTime reviewedAt\n        +String comments\n        +approve()\n        +reject()\n        +requestCorrection()\n    }\n\n    class ScopeToken {\n        +String tokenId\n        +DateTime issuedAt\n        +DateTime expiresAt\n        +Boolean isValid\n        +validateToken()\n    }\n\n    class SecurityTest {\n        +String testId\n        +String status\n        +DateTime startTime\n        +DateTime endTime\n        +startTest()\n        +stopTest()\n    }\n\n    class Finding {\n        +String findingId\n        +String title\n        +String description\n        +String severity\n        +String affectedComponent\n    }\n\n    class RiskAssessment {\n        +Float riskScore\n        +String riskLevel\n        +calculateRisk()\n    }\n\n    class Report {\n        +String reportId\n        +DateTime generatedAt\n        +String reportContent\n        +generateReport()\n        +downloadReport()\n    }\n\n    class AuditLogEntry {\n        +String logId\n        +String action\n        +DateTime timestamp\n        +String details\n        +recordAction()\n    }\n\n    User &lt;|-- Tester\n    User &lt;|-- Admin\n\n    AuthenticationService ..&gt; User : authenticates\n    AuthenticationService ..&gt; Tester : authenticates tester\n    AuthenticationService ..&gt; Admin : authenticates admin\n\n    Tester \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Target : registers\n    Tester \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ROEDocument : submits\n    ROEDocument \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Target : defines scope\n\n    ROEDocument \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ROEReview : may require review\n    Admin \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ROEReview : reviews ROE\n    ROEDocument \&quot;1\&quot; --&gt; \&quot;0..1\&quot; ScopeToken : authorizes\n\n    ScopeToken \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SecurityTest : permits\n    Tester \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SecurityTest : requests\n    SecurityTest \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Finding : discovers\n    Finding \&quot;1\&quot; --&gt; \&quot;1\&quot; RiskAssessment : receives\n    SecurityTest \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Report : produces\n    Report \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Finding : includes\n\n    SecurityTest \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AuditLogEntry : records actions\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AuditLogEntry : performs actions\n    Admin ..&gt; AuditLogEntry : views all logs\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="NOZhiDxJaNAPWvaNGuQt-42">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
